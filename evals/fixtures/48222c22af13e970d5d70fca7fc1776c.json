        "content": "<customer>nimekatwa mara mbili KES 700</customer>\n<ledger>[{\"id\": \"t0\", \"amount\": \"700\", \"kind\": \"charge\"}, {\"id\": \"t1\", \"amount\": \"700\", \"kind\": \"charge\"}]</ledger>",
